{
  "name": "lambda-raiz",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "serverless offline --stage dev",
    "debug": "set Stage=dev && set SLS_DEBUG=* && npx --yes serverless offline --stage dev",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "test": "node --test tests/*.test.cjs",
    "typecheck:pagamento": "tsc -p tsconfig.pagamento.json",
    "build:pagamento": "esbuild src/functions/rm/post/solicitacaoDePagamento.ts --bundle --platform=node --target=node22 --outfile=.build/solicitacaoDePagamento.cjs",
    "verify:pagamento": "npm test && npm run typecheck:pagamento && npm run build:pagamento"
  },
  "keywords": [],
