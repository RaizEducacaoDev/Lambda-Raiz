  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@serverless/typescript": "^3.38.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.13.10",
    "dynalite": "4.0.0",
    "esbuild": "^0.25.1",
    "serverless": "^4.9.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^14.4.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1147.0",
    "@aws-sdk/lib-dynamodb": "3.1147.0",
    "axios": "1.8.3",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "5.7.3",
